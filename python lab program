        "    with o:\n",
        "        o.clear_output()\n",
        "        with open(\"students.csv\",\"w\",newline=\"\") as f:\n",
        "            x=csv.DictWriter(f,[\"Name\",\"Department\",\"Mark\"]);x.writeheader();x.writerows(r)\n",
        "        print(\"CSV file created successfully.\")\n",
        "\n",
        "def load(b):\n",
        "    with o:\n",
        "        o.clear_output();r.clear()\n",
        "        with open(\"students.csv\") as f:r.extend(csv.DictReader(f))\n",
        "        print(\"CSV data loaded successfully.\")\n",
        "\n",
        "def show(b):\n",
        "    with o:\n",
        "        o.clear_output()\n",
        "        for x in r:print(x)\n",
