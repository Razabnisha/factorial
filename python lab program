        "a.on_click(add);s.on_click(save);l.on_click(load);p.on_click(show)\n",
        "display(w.VBox([w.HTML(\"<h2 style='color:orange'>CSV Data Management</h2>\"),n,d,m,w.HBox([a,s,l,p]),o]))"
