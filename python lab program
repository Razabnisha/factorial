        "import ipywidgets as w\n",
        "from IPython.display import display\n",
        "\n",
        "t=w.Text(description=\"String:\",placeholder=\"Enter a string\"); o=w.Output()\n",
        "ops=[\"UPPER\",\"lower\",\"Title\",\"Reverse\",\"Length\",\"Count\",\"Replace\",\"Split\",\"Strip\"]\n",
        "\n",
        "def f(b):\n",
        " s=t.value\n",
        " with o:\n",
        "  o.clear_output()\n",
        "  if not s: print(\"Please enter a string.\"); return\n",
        "  k=b.description\n",
        "  if k==\"Count\":\n",
        "   c=w.Text(description=\"Character:\"); x=w.Button(description=\"Count\")\n",
        "   display(c,x); x.on_click(lambda _:print(\"Count:\",s.count(c.value)))\n",
        "  elif k==\"Replace\": print(\"Original:\",s); print(\"Replace example:\",s.replace(\"a\",\"@\"))\n",
        "  else:\n",
        "   r={\"UPPER\":s.upper(),\"lower\":s.lower(),\"Title\":s.title(),\"Reverse\":s[::-1],\n",
        "      \"Length\":len(s),\"Split\":s.split(),\"Strip\":s.strip()}[k]\n",
        "   print((\"Length:\" if k==\"Length\" else \"Result:\"),r)\n",
        "\n",
        "bs=[]\n",
        "for x in ops:\n",
        " b=w.Button(description=x); b.on_click(f); bs.append(b)\n",
        "\n",
        "display(w.VBox([w.HTML(\"<h2>String Function Explorer</h2>\"),t,\n",
        " w.HBox(bs[:5]),w.HBox(bs[5:]),o]))"
      ],
