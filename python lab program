        "import ipywidgets as w, math\n",
        "from IPython.display import display\n",
        "\n",
        "e=\"\"\n",
        "d=w.Text(placeholder=\"0\",disabled=True)\n",
        "\n",
        "def f(b):\n",
        "    global e\n",
        "    k=b.description\n",
        "    try:\n",
        "        if k==\"C\": e=\"\"\n",
        "        elif k==\"⌫\": e=e[:-1]\n",
        "        elif k==\"=\": e=str(eval(e.replace(\"^\",\"**\"),{\"__builtins__\":None},{}))\n",
        "        elif k==\"√\": e=str(math.sqrt(float(e)))\n",
        "        elif k==\"x²\": e=str(float(e)**2)\n",
        "        elif k==\"1/x\": e=str(1/float(e))\n",
        "        elif k==\"%\": e=str(float(e)/100)\n",
        "        elif k in \"sin cos tan\": e=str(getattr(math,k)(math.radians(float(e))))\n",
        "        else: e+=k\n",
        "    except: e=\"Error\"\n",
        "    d.value=e\n",
        "\n",
        "B=\"C ⌫ ( ) /;7 8 9 * %;4 5 6 - √;1 2 3 + x²;0 . ^ 1/x =;sin cos tan\"\n",
        "R=[]\n",
        "for r in B.split(\";\"):\n",
        "    x=[]\n",
        "    for t in r.split():\n",
        "        b=w.Button(description=t); b.on_click(f); x.append(b)\n",
        "    R.append(w.HBox(x))\n",
        "\n",
        "display(w.VBox([w.HTML(\"<h2>Advanced Python Calculator</h2>\"),d]+R))"
      ]
